# Firebase — mismo proyecto que apps/desktop. El SDK web firma el login
# (Firebase Auth solo puede autenticar con email/password desde el
# navegador); son valores públicos, no secretos.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Admin SDK — server actions y /api/session, nunca en el navegador. En local
# basta con `firebase login` (usa las credenciales de usuario ya presentes,
# ver lib/firebase/admin.ts); en producción, cuenta de servicio propia
# (Firebase Console → Configuración del proyecto → Cuentas de servicio →
# Generar nueva clave privada).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# URL pública de apps/desktop y secreto compartido, para el webhook que
# revalida /blog al guardar o publicar un post.
DESKTOP_SITE_URL=http://localhost:3001
REVALIDATE_SECRET=
