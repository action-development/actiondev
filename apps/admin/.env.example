# Supabase — mismo proyecto que apps/desktop. La anon key + sesión de
# usuario autenticado basta: RLS filtra por email en la policy de escritura.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública de apps/desktop y secreto compartido, para el webhook que
# revalida /blog al guardar o publicar un post.
DESKTOP_SITE_URL=http://localhost:3001
REVALIDATE_SECRET=
