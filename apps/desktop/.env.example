# Firebase — lectura pública de posts publicados e inserción de leads (esta última, por REST desde `POST /api/lead`)
# (firestore.rules limita a `status == 'published'` en lectura y a `create`
# en `leads`). Son valores públicos del SDK web, no secretos.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Secreto compartido con apps/admin para el webhook de revalidación de /blog.
REVALIDATE_SECRET=

# Destino del proxy /admin (deploy de apps/admin). En local: http://localhost:3003
ADMIN_URL=http://localhost:3003

# Aviso inmediato de cada lead nuevo (`POST /api/lead`, solo servidor). Sin estas
# variables el lead se guarda igual y simplemente no avisa. Email por SMTP
# (one.com: send.one.com, puerto 465 = SSL) y, opcional, Telegram.
LEAD_SMTP_HOST=
LEAD_SMTP_PORT=
LEAD_SMTP_USER=
LEAD_SMTP_PASS=
LEAD_NOTIFY_FROM=
# Lista separada por comas.
LEAD_NOTIFY_TO=
# Opcional: si existen los dos, además del email manda un resumen por Telegram.
LEAD_TELEGRAM_BOT_TOKEN=
LEAD_TELEGRAM_CHAT_ID=

# Reenvío de cada lead al ERP interno (`POST /api/leads/inbound`, solo servidor).
# Sin estas dos variables el lead se guarda igual y no se reenvía. También las
# usa `scripts/backfill-leads-to-erp.ts`.
LEAD_ERP_URL=
LEAD_ERP_SECRET=

# Leads de los formularios instantáneos de Meta (`/api/meta/leads` y
# `/api/meta/leads/sync`, solo servidor). Sin ellas las rutas responden 503.
# Secreto de la app de Meta: firma del webhook (X-Hub-Signature-256) y appsecret_proof.
META_APP_SECRET=
# Cadena aleatoria que se pega también en Webhooks del panel de la app.
META_WEBHOOK_VERIFY_TOKEN=
# Token del usuario del sistema (leads_retrieval, pages_manage_ads,
# pages_read_engagement, pages_show_list, ads_read).
META_LEADS_TOKEN=
META_PAGE_ID=
# Mismo valor que el secreto de GitHub Actions META_LEADS_SYNC_SECRET (cron).
META_LEADS_SYNC_SECRET=
# Opcionales: ids de formulario por comas (limita el sync), versión de la Graph
# API (por defecto v26.0) y 1 para no descartar los leads orgánicos.
META_FORM_IDS=
META_GRAPH_VERSION=
META_LEADS_INCLUDE_ORGANIC=
