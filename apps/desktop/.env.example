# Firebase — lectura pública de posts publicados e inserción de leads
# (firestore.rules limita a `status == 'published'` en lectura y a `create`
# en `leads`). Son valores públicos del SDK web, no secretos.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Secreto compartido con apps/admin para el webhook de revalidación de /blog.
REVALIDATE_SECRET=
