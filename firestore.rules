rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rol resuelto por custom claim (`role: "admin" | "client"`), no por
    // email hardcodeado — ver apps/admin/src/lib/firebase/session.ts y
    // apps/desktop/src/lib/portal/session.ts. Un admin nuevo se da de alta
    // asignándole el claim en Firebase, sin tocar este archivo.
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    function isClient() {
      return request.auth != null && request.auth.token.role == 'client';
    }

    match /posts/{postId} {
      allow get, list: if resource.data.status == 'published';
      allow read, write: if isAdmin();
    }
    // Campo opcional de texto: ausente, o string con tope de longitud.
    function optStr(m, k, max) {
      return !(k in m) || (m[k] is string && m[k].size() <= max);
    }
    // Campo opcional de unión cerrada: ausente, o uno de los valores.
    function optIn(m, k, allowed) {
      return !(k in m) || (m[k] is string && m[k] in allowed);
    }

    // Atribución publicitaria (LeadAttribution en packages/shared/src/leads.ts):
    // solo esas claves, todas string <= 300.
    function validAttribution(a) {
      return a is map &&
        a.keys().hasOnly(['utmSource', 'utmMedium', 'utmCampaign', 'utmTerm',
          'utmContent', 'gclid', 'gbraid', 'wbraid', 'fbclid', 'landingPath']) &&
        optStr(a, 'utmSource', 300) && optStr(a, 'utmMedium', 300) &&
        optStr(a, 'utmCampaign', 300) && optStr(a, 'utmTerm', 300) &&
        optStr(a, 'utmContent', 300) && optStr(a, 'gclid', 300) &&
        optStr(a, 'gbraid', 300) && optStr(a, 'wbraid', 300) &&
        optStr(a, 'fbclid', 300) && optStr(a, 'landingPath', 300);
    }

    // Lead enviado por un visitante anónimo (Lead en packages/shared/src/leads.ts).
    // Si se añade un campo allí, añadirlo aquí. Los campos del panel
    // (statusUpdatedAt, qualifiedAt, wonAt, value, lostReason) NO se admiten al
    // crear: solo los escribe un admin con update.
    function validLead(d) {
      return d.keys().hasOnly(['phone', 'notes', 'status', 'createdAt', 'source',
          'name', 'email', 'company', 'need', 'stage', 'budget',
          'contactPreference', 'attribution', 'consent', 'privacyVersion']) &&
        d.keys().hasAll(['phone', 'notes', 'status', 'createdAt']) &&
        d.phone is string && d.phone.size() >= 6 && d.phone.size() <= 30 &&
        d.notes is string && d.notes.size() <= 500 &&
        d.status == 'new' &&
        d.createdAt is string && d.createdAt.size() <= 40 &&
        optIn(d, 'source', ['callback_form', 'ads_landing', 'seo_landing', 'contact_page', 'meta_lead_form']) &&
        optStr(d, 'name', 120) &&
        optStr(d, 'email', 160) &&
        optStr(d, 'company', 160) &&
        optIn(d, 'need', ['app', 'software', 'integration', 'web', 'unsure']) &&
        optIn(d, 'stage', ['idea', 'defined', 'existing']) &&
        optIn(d, 'budget', ['lt5k', '5k-15k', '15k-40k', 'gt40k', 'unknown']) &&
        optIn(d, 'contactPreference', ['call', 'whatsapp', 'email']) &&
        optIn(d, 'consent', ['granted', 'denied', 'unknown']) &&
        optStr(d, 'privacyVersion', 20) &&
        (!('attribution' in d) || validAttribution(d.attribution));
    }

    match /leads/{leadId} {
      allow create: if validLead(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isAdmin() || (isClient() && request.auth.uid == clientId);
      allow write: if isAdmin();
    }

    match /clientProjects/{projectId} {
      allow read: if isAdmin() ||
        (isClient() && resource.data.clientId == request.auth.token.clientId);
      allow create, update, delete: if isAdmin();

      match /milestones/{milestoneId} {
        allow read: if isAdmin() ||
          (isClient() &&
           get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientId == request.auth.token.clientId);
        allow write: if isAdmin();
      }

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          (isClient() &&
           get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientId == request.auth.token.clientId);
        allow create: if request.auth != null &&
          request.resource.data.authorEmail == request.auth.token.email &&
          request.resource.data.authorRole == request.auth.token.role &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000 &&
          request.resource.data.createdAt == request.time &&
          (isAdmin() ||
           (isClient() &&
            get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientId == request.auth.token.clientId));
        // Mensajes inmutables: ni admin edita/borra un mensaje ya enviado.
        allow update, delete: if false;
      }

      // Feedback del cliente (bugs, cambios, mejoras). Inmutable una vez enviado.
      match /feedback/{feedbackId} {
        allow read: if isAdmin() ||
          (isClient() &&
           get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientId == request.auth.token.clientId);
        allow create: if request.auth != null &&
          request.resource.data.authorEmail == request.auth.token.email &&
          request.resource.data.authorRole == request.auth.token.role &&
          request.resource.data.type in ['bug', 'implementation', 'design', 'content', 'other'] &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000 &&
          request.resource.data.createdAt == request.time &&
          (isAdmin() ||
           (isClient() &&
            get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientId == request.auth.token.clientId));
        allow update, delete: if false;
      }

      // Documentos del proyecto (portal). El binario vive en Storage
      // (projects/{projectId}/documents/**, ver storage.rules); aquí solo los
      // metadatos. El nombre del objeto en Storage empieza por el id de este doc.
      match /documents/{docId} {
        allow read: if isAdmin() ||
          (isClient() &&
           get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientId == request.auth.token.clientId);
        allow create: if request.auth != null &&
          request.resource.data.uploadedByEmail == request.auth.token.email &&
          request.resource.data.uploadedByRole == request.auth.token.role &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 255 &&
          request.resource.data.size is number &&
          request.resource.data.size <= 26214400 &&
          request.resource.data.storagePath.matches('projects/' + projectId + '/documents/' + docId + '-.*') &&
          request.resource.data.createdAt == request.time &&
          (isAdmin() ||
           (isClient() &&
            get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientId == request.auth.token.clientId));
        // Los metadatos son inmutables; borra un admin o el propio autor cliente.
        allow update: if false;
        allow delete: if isAdmin() ||
          (isClient() &&
           resource.data.uploadedByEmail == request.auth.token.email &&
           get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientId == request.auth.token.clientId);
      }

      // Facturas del proyecto (portal). Solo las gestiona un admin; el cliente
      // dueño del proyecto las lee. El binario vive en Storage
      // (projects/{projectId}/invoices/**, ver storage.rules).
      match /invoices/{invoiceId} {
        allow read: if isAdmin() ||
          (isClient() &&
           get(/databases/$(database)/documents/clientProjects/$(projectId)).data.clientId == request.auth.token.clientId);
        allow create: if isAdmin() &&
          request.resource.data.uploadedByEmail == request.auth.token.email &&
          request.resource.data.uploadedByRole == 'admin' &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 255 &&
          request.resource.data.size is number &&
          request.resource.data.size <= 26214400 &&
          request.resource.data.storagePath.matches('projects/' + projectId + '/invoices/' + invoiceId + '-.*') &&
          request.resource.data.createdAt == request.time;
        // Inmutables: para corregir una factura se borra y se sube de nuevo.
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
